# Copie este archivo a .env.directus y cambie TODOS los valores antes de usarlo.
SECRET=cambie-este-valor-por-uno-aleatorio-largo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambie-esta-contrasena
# Token estático del administrador: es el que usa SICODE (DIRECTUS_TOKEN en .env.local).
ADMIN_TOKEN=cambie-este-token
PUBLIC_URL=http://localhost:8055
